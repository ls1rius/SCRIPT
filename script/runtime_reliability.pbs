#!/bin/bash
#PBS -N script-runtime-repair
#PBS -P CFP05-CF-136
#PBS -l select=1:ngpus=1:ncpus=12:mem=225gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -r n
set -euo pipefail
cd "$PBS_O_WORKDIR"
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 TOKENIZERS_PARALLELISM=false
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTHONUNBUFFERED=1
export TMPDIR="$REPAIR_DIR/.tmp-job-$REPAIR_JOB"
mkdir -p "$TMPDIR"
/home/svu/e1583416/work/miniconda3/envs/vts/bin/python \
    "$REPAIR_DIR/source/script/verify_runtime_repairs.py" run-job \
    --out "$REPAIR_DIR" --index "$REPAIR_JOB"
