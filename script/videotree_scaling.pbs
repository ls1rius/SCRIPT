#!/bin/bash
#PBS -N videotree-scaling
#PBS -P CFP05-CF-136
#PBS -l select=1:ngpus=1
#PBS -l walltime=04:00:00
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 TOKENIZERS_PARALLELISM=false
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTHONUNBUFFERED=1
export TMPDIR="$SCALING_DIR/.tmp-job-${SCALING_JOB:-0}"
mkdir -p "$TMPDIR"
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv
/home/svu/e1583416/work/miniconda3/envs/vts/bin/python "$SCALING_DIR/source/script/run_videotree_scaling.py" \
    run-job --out "$SCALING_DIR" --index "${SCALING_JOB:-0}"
