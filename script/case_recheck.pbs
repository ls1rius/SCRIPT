#!/bin/bash
#PBS -N script-case-recheck
#PBS -P CFP05-CF-136
#PBS -l select=1:ngpus=1:ncpus=12:mem=225GB:gpu_model=H200
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -r n
set -euo pipefail
cd "$PBS_O_WORKDIR"
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 TOKENIZERS_PARALLELISM=false
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTHONUNBUFFERED=1
export TMPDIR="$REPAIR_DIR/.tmp"
mkdir -p "$TMPDIR"
RECHECK_PYTHON=/home/svu/e1583416/work/miniconda3/envs/vts/bin/python
RECHECK_STATUS=0
"$RECHECK_PYTHON" "$REPAIR_DIR/source/script/verify_runtime_repairs.py" run-job \
    --out "$REPAIR_DIR" --index 0 || RECHECK_STATUS=$?
"$RECHECK_PYTHON" "$REPAIR_DIR/source/script/verify_runtime_repairs.py" summarize --out "$REPAIR_DIR" || RECHECK_STATUS=$?
if [ -f "$REPAIR_DIR/build_probe/manifest.json" ]; then
    "$RECHECK_PYTHON" "$REPAIR_DIR/source/script/verify_runtime_repairs.py" probe-build --out "$REPAIR_DIR" || RECHECK_STATUS=$?
fi
exit "$RECHECK_STATUS"
