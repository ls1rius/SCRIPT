#!/bin/bash
#PBS -N script-repairs-300
#PBS -P CFP05-CF-136
#PBS -l select=1:ngpus=1:ncpus=12:mem=225GB:gpu_model=H200
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -r n
set -euo pipefail
cd "$PBS_O_WORKDIR"
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 TOKENIZERS_PARALLELISM=false
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTHONUNBUFFERED=1
export TMPDIR="$REPAIR_300_DIR/.tmp-job-$REPAIR_300_JOB"
mkdir -p "$TMPDIR"
/home/svu/e1583416/work/miniconda3/envs/vts/bin/python "$REPAIR_300_DIR/source/script/run_repairs_300.py" \
    run-job --out "$REPAIR_300_DIR" --index "$REPAIR_300_JOB"
