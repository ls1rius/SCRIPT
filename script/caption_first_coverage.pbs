#!/bin/bash
#PBS -N caption-coverage-300
#PBS -P CFP05-CF-136
#PBS -l select=1:ngpus=1:ncpus=12:mem=225GB:gpu_model=H200
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -r n
set -euo pipefail
cd "$PBS_O_WORKDIR"
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 TOKENIZERS_PARALLELISM=false
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTHONUNBUFFERED=1
export TMPDIR="$CAPTION_FIRST_DIR/.tmp-$CAPTION_FIRST_STAGE"
mkdir -p "$TMPDIR"
CAPTION_PYTHON=/home/svu/e1583416/work/miniconda3/envs/vts/bin/python
CAPTION_EXIT=0
"$CAPTION_PYTHON" "$CAPTION_FIRST_DIR/source/script/run_caption_first.py" run \
    --out "$CAPTION_FIRST_DIR" --stage "$CAPTION_FIRST_STAGE" || CAPTION_EXIT=$?
"$CAPTION_PYTHON" "$CAPTION_PAIR_DIR/analysis_source/compare_caption_first_arms.py" score \
    --out "$CAPTION_PAIR_DIR"
exit "$CAPTION_EXIT"
